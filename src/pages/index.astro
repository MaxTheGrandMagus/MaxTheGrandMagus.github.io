---
// Split: a sticky profile column on the left, the CV on the right.
// The section list in the left column follows the reader: that scrollspy is the page's one signature detail.
import '@fontsource-variable/dm-sans/opsz.css';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile.js';
import { results } from '../data/results.js';
import { experience } from '../data/experience.js';
import { skills } from '../data/skills.js';
import { formatMonth, formatDuration, monthsBetween, yearsSince } from '../lib/dates.js';

const capitalize = (/** @type {string} */ s) => s.charAt(0).toUpperCase() + s.slice(1);

// Keeps hyphenated words such as "form-filling" on one line: the parts at odd indexes get a nowrap span.
const keepHyphens = (/** @type {string} */ s) => s.split(/(\S+-\S+)/);

/* ——— Profile ——— */

const years = yearsSince(profile.careerStart);

/** A hero field's value with `{years}` filled in. */
const field = (/** @type {string} */ label) =>
  profile.fields.find((f) => f.label === label)?.value.replaceAll('{years}', String(years)) ?? '';

// "Maksat Batyrov" → "MB": the first letters of the first and the last word.
const words = profile.name.trim().split(/\s+/);
const initials = [words[0], words.length > 1 ? words[words.length - 1] : '']
  .map((w) => w.charAt(0))
  .join('')
  .toUpperCase();

// The UTC offset is rendered on the server; the script below adds the live time in front of it.
const tz = profile.timezone;
const utcOffset = (() => {
  try {
    const name = new Intl.DateTimeFormat('en', { timeZone: tz, timeZoneName: 'shortOffset' })
      .formatToParts(new Date())
      .find((p) => p.type === 'timeZoneName')?.value;
    return name ? name.replace('GMT', 'UTC') : '';
  } catch {
    return '';
  }
})();

const facts = [
  { label: 'Based in', value: field('Based in'), clock: true },
  { label: 'Works', value: field('Works'), clock: false },
  { label: 'Experience', value: `${years}+ years`, clock: false },
].filter((f) => f.value);

const email = profile.links.find((l) => l.href.startsWith('mailto:'));
const address = email ? email.href.replace(/^mailto:/, '').split('?')[0] : '';
const profiles = profile.links.filter((l) => l !== email);

/* ——— Sections: the scrollspy lists these; "Education and languages" is read under Skills ——— */

const sections = [
  { id: 'overview', label: 'Overview' },
  ...(results.length ? [{ id: 'results', label: 'Results' }] : []),
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];

/* ——— Overview ——— */

const latest = experience[0];
const isCurrent = Boolean(latest && !latest.end);
// Split on commas only, so "crypto and Web3" stays one domain.
const domains = field('Domains')
  .split(/\s*,\s*/)
  .filter(Boolean)
  .map(capitalize);

/* ——— Results, experience, background, contact ——— */

const source = (/** @type {{ company: string, project?: string }} */ r) =>
  r.project ? `${r.project} at ${r.company}` : r.company;

const jobs = experience.map((j) => ({ ...j, duration: formatDuration(monthsBetween(j.start, j.end)) }));

// "Education and languages", built from the labels, so a new row also renames the section.
const backgroundTitle = profile.background
  .map((b, i) => (i ? b.label.toLowerCase() : b.label))
  .join(', ')
  .replace(/, ([^,]*)$/, ' and $1');

const contacts = [
  ...profile.links.map((l) => ({ ...l, download: false, copy: l === email })),
  ...(profile.cv ? [{ label: 'CV', value: 'Download PDF', href: profile.cv, download: true, copy: false }] : []),
];

const year = new Date().getFullYear();
---

<Base>
  <Fragment slot="head">
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0e10" media="(prefers-color-scheme: dark)" />
    <!-- Applies the visitor's saved light/dark choice before the first paint, so the page never flashes. -->
    <script is:inline>
      try {
        const scheme = localStorage.getItem('scheme');
        if (scheme === 'light' || scheme === 'dark') document.documentElement.dataset.scheme = scheme;
      } catch {}
    </script>
  </Fragment>

  <div class="page">
    <div class="side">
      <header class="profile">
        <div class="profile-top">
          <div class="avatar" aria-hidden="true">{initials}</div>
          <button
            type="button"
            class="scheme-toggle"
            aria-label="Dark theme"
            aria-pressed="false"
            data-scheme-toggle
            hidden
          >
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
              ></path>
            </svg>
          </button>
        </div>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        {
          profile.intro && (
            <p class="intro">
              {keepHyphens(profile.intro).map((part, i) => (i % 2 ? <span class="nowrap">{part}</span> : part))}
            </p>
          )
        }
        <dl class="facts">
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>
                  {f.value}
                  {f.clock && utcOffset && (
                    <>
                      <span class="sr-only">, </span>
                      <span class="clock num" data-clock data-tz={tz}>
                        {utcOffset}
                      </span>
                    </>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="actions">
          {
            profile.cv && (
              <a class="button" href={profile.cv} download>
                Download CV (PDF)
              </a>
            )
          }
          {email && <a class="text-link" href={email.href}>Email me</a>}
        </div>
      </header>

      <nav class="spy" aria-label="On this page" data-spy>
        <div class="spy-track" data-spy-track>
          <ul class="spy-list">
            {
              sections.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.label}</a>
                </li>
              ))
            }
          </ul>
          <span class="spy-bar" data-spy-bar hidden></span>
        </div>
      </nav>

      <ul class="social" aria-label="Profiles">
        {
          profiles.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col">
      <main class="content">
        <section id="overview" class="section" aria-labelledby="overview-title">
          <h2 id="overview-title">Overview</h2>
          {
            latest && (
              <div class="now">
                <div class="now-head">
                  <h3 class:list={['now-label', { 'is-live': isCurrent }]}>{isCurrent ? 'Now' : 'Latest role'}</h3>
                  <p class="now-since num">
                    {isCurrent ? (
                      <>
                        Since <time datetime={latest.start}>{formatMonth(latest.start)}</time>
                      </>
                    ) : (
                      <>
                        <time datetime={latest.start}>{formatMonth(latest.start)}</time> –{' '}
                        <time datetime={latest.end}>{formatMonth(latest.end)}</time>
                      </>
                    )}
                  </p>
                </div>
                <p class="now-company">{latest.company}</p>
                <p class="now-role">{latest.role}</p>
                <p class="now-summary">
                  {keepHyphens(latest.summary).map((t, i) => (i % 2 ? <span class="nowrap">{t}</span> : t))}
                </p>
              </div>
            )
          }
          {
            domains.length > 0 && (
              <div class="pair domains">
                <h3 class="label">Domains</h3>
                <ul class="chips">
                  {domains.map((d) => (
                    <li class="chip">{d}</li>
                  ))}
                </ul>
              </div>
            )
          }
        </section>

        {
          results.length > 0 && (
            <section id="results" class="section" aria-labelledby="results-title">
              <h2 id="results-title">Results</h2>
              <ul class="results" role="list">
                {results.map((r) => (
                  <li class="result">
                    {r.before && (
                      <p class="r-before num">
                        <span class="sr-only">Before: </span>
                        <s>{r.before}</s>
                      </p>
                    )}
                    <p class="r-after num">
                      {r.before && <span class="sr-only">After: </span>}
                      {r.after}
                    </p>
                    <p class="r-what">
                      {keepHyphens(r.what).map((t, i) => (i % 2 ? <span class="nowrap">{t}</span> : t))}
                    </p>
                    <p class="r-source">{source(r)}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section id="experience" class="section" aria-labelledby="experience-title">
          <h2 id="experience-title">Experience</h2>
          <ol class="jobs" role="list">
            {
              jobs.map((job) => (
                <li>
                  <details class="job">
                    <summary>
                      {/* The sr-only commas keep the disclosure's accessible name from running together. */}
                      <span class="job-company">{job.company}</span>
                      <span class="job-role">
                        <span class="sr-only">, </span>
                        {job.role}
                      </span>
                      <span class="job-meta num">
                        <span class="job-dates">
                          <span class="sr-only">, </span>
                          <time datetime={job.start}>{formatMonth(job.start)}</time> –{' '}
                          {job.end ? <time datetime={job.end}>{formatMonth(job.end)}</time> : 'Present'}
                        </span>
                        <span class="job-sep">, </span>
                        <span class="job-dur">{job.duration}</span>
                      </span>
                      <svg class="job-chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                        <path
                          d="M4 6l4 4 4-4"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </summary>
                    <div class="job-body">
                      <p>{keepHyphens(job.summary).map((t, i) => (i % 2 ? <span class="nowrap">{t}</span> : t))}</p>
                      <ul class="job-highlights">
                        {job.highlights.map((h) => (
                          <li>{keepHyphens(h).map((t, i) => (i % 2 ? <span class="nowrap">{t}</span> : t))}</li>
                        ))}
                      </ul>
                      {job.stack && (
                        <ul class="chips" aria-label="Stack">
                          {job.stack.map((s) => (
                            <li class="chip">{s}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </details>
                </li>
              ))
            }
          </ol>
        </section>

        <section id="skills" class="section" aria-labelledby="skills-title">
          <h2 id="skills-title">Skills</h2>
          <div class="skills">
            {
              skills.map((g) => (
                <div class="pair">
                  <h3 class="label">{g.group}</h3>
                  <ul class="chips">
                    {g.items.map((item) => (
                      <li class="chip">{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </section>

        {
          profile.background.length > 0 && (
            <section id="background" class="section" aria-labelledby="background-title">
              <h2 id="background-title">{backgroundTitle}</h2>
              <dl class="rows">
                {profile.background.map((b) => (
                  <div class="pair row">
                    <dt class="label">{b.label}</dt>
                    <dd>{b.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        <section id="contact" class="section" aria-labelledby="contact-title">
          <h2 id="contact-title">Contact</h2>
          <dl class="rows">
            {
              contacts.map((c) => (
                <div class="pair row">
                  <dt class="label">{c.label}</dt>
                  <dd class="row-value">
                    <a href={c.href} download={c.download || undefined}>
                      {c.value}
                    </a>
                    {c.copy && address && (
                      <button type="button" class="copy" data-copy={address} hidden>
                        <span class="copy-label copy-idle">Copy email</span>
                        <span class="copy-label copy-done">Email copied</span>
                      </button>
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>
          <p class="sr-only" role="status" aria-live="polite" data-status></p>
        </section>
      </main>

      <footer class="foot" data-spy-end>
        <p>© {year} {profile.name}</p>
      </footer>
    </div>
  </div>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Animations run only when the visitor hasn't asked the system to reduce motion.
  const moving = () => !reduce.matches;

  /* ——— Light/dark switch: follows the system until the visitor picks a side; the choice is remembered ——— */

  const schemeToggle = document.querySelector('[data-scheme-toggle]');
  if (schemeToggle instanceof HTMLButtonElement) {
    const root = document.documentElement;
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
    const themeColors = [...document.querySelectorAll('meta[name="theme-color"]')];
    const current = () => root.dataset.scheme ?? (systemDark.matches ? 'dark' : 'light');

    const sync = () => {
      const dark = current() === 'dark';
      schemeToggle.setAttribute('aria-pressed', String(dark));
      schemeToggle.title = dark ? 'Switch to light theme' : 'Switch to dark theme';
      // After a manual pick, the browser bar takes the page's background too.
      if (root.dataset.scheme) {
        const bg = getComputedStyle(root).getPropertyValue('--bg').trim();
        themeColors.forEach((meta) => meta.setAttribute('content', bg));
      }
    };

    schemeToggle.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      const apply = () => {
        root.dataset.scheme = next;
        try {
          localStorage.setItem('scheme', next);
        } catch {
          // Private mode: the switch still works for this visit.
        }
        sync();
      };

      // The new theme spreads from the button as a growing circle (View Transitions); elsewhere it just switches.
      if (!moving() || !document.startViewTransition || document.visibilityState !== 'visible') return apply();
      const box = schemeToggle.getBoundingClientRect();
      const x = box.left + box.width / 2;
      const y = box.top + box.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      document
        .startViewTransition(apply)
        .ready.then(() => {
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
            { duration: 560, easing: 'cubic-bezier(0.2, 0, 0, 1)', pseudoElement: '::view-transition-new(root)' },
          );
        })
        // An aborted transition (e.g. the tab got hidden) still switches the theme, just without the circle.
        .catch(() => {});
    });

    systemDark.addEventListener('change', sync);
    schemeToggle.hidden = false;
    sync();
  }

  /* ——— Clock: the live time in the profile's time zone, in front of the server-rendered UTC offset ——— */

  const clock = /** @type {HTMLElement | null} */ (document.querySelector('[data-clock]'));
  if (clock?.dataset.tz) {
    try {
      const format = new Intl.DateTimeFormat('en-GB', {
        timeZone: clock.dataset.tz,
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      });
      const offset = clock.textContent?.trim() ?? '';
      const suffix = ` local time${offset ? ` (${offset})` : ''}`;
      let last = '';
      const tick = () => {
        const time = format.format(new Date());
        if (time === last) return;
        if (!moving()) {
          clock.textContent = time + suffix;
        } else {
          // The colon blinks, and the minutes roll in when they change.
          const [hh, mm] = time.split(':');
          const rolled = last !== '' && last.slice(3) !== mm;
          clock.innerHTML =
            `<span class="clock-time" aria-hidden="true">${hh}<span class="clock-colon">:</span>` +
            `<span class="clock-min${rolled ? ' is-rolling' : ''}">${mm}</span></span>` +
            `<span class="sr-only">${time}</span>${suffix}`;
        }
        last = time;
      };
      tick();
      window.setInterval(tick, 1000);
    } catch {
      // An unknown time zone keeps the UTC offset.
    }
  }

  /* ——— Scrollspy: the section whose top has passed a line at 31% of the viewport is the current one ——— */

  const nav = /** @type {HTMLElement | null} */ (document.querySelector('[data-spy]'));
  const track = /** @type {HTMLElement | null} */ (nav?.querySelector('[data-spy-track]') ?? null);
  const bar = /** @type {HTMLElement | null} */ (nav?.querySelector('[data-spy-bar]') ?? null);

  if (nav && track && bar && 'IntersectionObserver' in window) {
    const links = /** @type {HTMLAnchorElement[]} */ ([...nav.querySelectorAll('a[href^="#"]')]);
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    const LINE = 0.31;
    let current = -1;
    let atEnd = false;
    let locked = false;
    let unlock = 0;

    /** Moves the indicator to the current link: a bar on its left in the column, an underline in the tab bar. */
    const place = () => {
      const a = links[current];
      if (!a) return;
      nav.style.setProperty('--spy-x', `${a.offsetLeft}px`);
      nav.style.setProperty('--spy-y', `${a.offsetTop}px`);
      nav.style.setProperty('--spy-w', `${a.offsetWidth}px`);
      nav.style.setProperty('--spy-h', `${a.offsetHeight}px`);
      bar.hidden = false;
    };

    /** In the horizontal tab bar, scrolls the active tab into view. A no-op when the list does not scroll. */
    const reveal = (/** @type {boolean} */ smooth) => {
      const a = links[current];
      if (!a) return;
      const pad = parseFloat(getComputedStyle(track).paddingInlineStart) || 0;
      const start = a.offsetLeft - pad;
      const end = a.offsetLeft + a.offsetWidth + pad - track.clientWidth;
      const left = Math.min(Math.max(track.scrollLeft, end), start);
      if (Math.abs(left - track.scrollLeft) > 1) {
        track.scrollTo({ left, behavior: smooth && !reduce.matches ? 'smooth' : 'auto' });
      }
    };

    /** Re-places the indicator without the slide, for resizes and font swaps. */
    const settle = () => {
      nav.dataset.still = '';
      place();
      reveal(false);
      void bar.offsetWidth;
      delete nav.dataset.still;
    };

    const activate = (/** @type {number} */ i) => {
      if (i === current || !links[i]) return;
      links[current]?.removeAttribute('aria-current');
      current = i;
      links[i].setAttribute('aria-current', 'true');
      place();
      // Instant until the page has settled, so nothing moves on load.
      reveal('ready' in nav.dataset);
    };

    const update = () => {
      if (locked) return;
      if (atEnd) return activate(links.length - 1);
      const line = window.innerHeight * LINE;
      let index = 0;
      targets.forEach((t, i) => {
        if (t && t.getBoundingClientRect().top <= line) index = i;
      });
      activate(index);
    };

    // A band from 30% to 31% of the viewport: every section edge that crosses it re-checks the current section.
    const bandObserver = new IntersectionObserver(update, { rootMargin: '-30% 0px -69% 0px' });
    targets.forEach((t) => t && bandObserver.observe(t));

    // At the end of the page the last section may never reach the line, so the footer coming into view selects it.
    const end = document.querySelector('[data-spy-end]');
    if (end) {
      new IntersectionObserver(([entry]) => {
        atEnd = entry.isIntersecting;
        update();
      }).observe(end);
    }

    // A click selects its section at once and holds it while the page scrolls there.
    const hold = (/** @type {number} */ ms) => {
      window.clearTimeout(unlock);
      unlock = window.setTimeout(() => (locked = false), ms);
    };
    nav.addEventListener('click', (event) => {
      // A modified click opens a new tab and leaves this page where it is.
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = /** @type {HTMLElement} */ (event.target).closest('a');
      const i = links.indexOf(/** @type {HTMLAnchorElement} */ (link));
      if (i < 0) return;
      locked = false;
      activate(i);
      locked = true;
      hold(400);
    });
    window.addEventListener('scroll', () => locked && hold(150), { passive: true });

    update();
    settle();

    const resize = new ResizeObserver(settle);
    resize.observe(track);
    links.forEach((a) => resize.observe(a));
    document.fonts?.ready.then(settle);

    // Placed without motion first; only later moves slide.
    requestAnimationFrame(() => requestAnimationFrame(() => (nav.dataset.ready = '')));
  }

  /* ——— Copy email ——— */

  const copy = /** @type {HTMLButtonElement | null} */ (document.querySelector('[data-copy]'));
  const status = document.querySelector('[data-status]');

  if (copy && navigator.clipboard?.writeText) {
    copy.hidden = false;
    let timer = 0;
    const announce = (/** @type {string} */ text) => {
      if (!status) return;
      status.textContent = '';
      window.setTimeout(() => (status.textContent = text), 50);
    };
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? '');
        copy.dataset.done = '';
        announce('Email copied to clipboard');
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          delete copy.dataset.done;
          if (status) status.textContent = '';
        }, 2000);
      } catch {
        announce('Could not copy the email');
      }
    });
  }

  /* ——— Results: as each one scrolls into view, the old value gets struck through and the new one counts ——— */

  if (moving() && 'IntersectionObserver' in window) {
    const seconds = /** @type {Record<string, number>} */ ({ s: 1, min: 60, h: 3600 });
    const parse = (/** @type {string} */ text) => {
      const m = text.trim().match(/^(\d+(?:\.\d+)?)(\s*)(%|×|s|min|h)?$/);
      return m ? { n: Number(m[1]), gap: m[2], unit: m[3] ?? '', decimals: (m[1].split('.')[1] ?? '').length } : null;
    };
    const ease = (/** @type {number} */ t) => 1 - (1 - t) ** 3;
    /** @type {WeakMap<Element, () => void>} */
    const counters = new WeakMap();

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          entry.target.classList.add('is-in');
          const count = counters.get(entry.target);
          if (count) window.setTimeout(count, 220);
        }
      },
      { threshold: 0.5 },
    );

    document.querySelectorAll('.result').forEach((result) => {
      const after = result.querySelector('.r-after');
      const node = after && [...after.childNodes].reverse().find((n) => n.nodeType === 3 && n.textContent?.trim());
      if (!after || !node) return;
      result.classList.add('is-animated');

      const final = node.textContent?.trim() ?? '';
      const to = parse(final);
      const before = parse(result.querySelector('.r-before s')?.textContent ?? '');

      // Where the count starts: the old value in the new unit, 0 for percentages, 1 for multipliers.
      let from = null;
      if (to && before && to.unit in seconds && before.unit in seconds) {
        from = (before.n * seconds[before.unit]) / seconds[to.unit];
      } else if (to?.unit === '%') from = 0;
      else if (to?.unit === '×') from = 1;

      if (to && from !== null) {
        // Screen readers and print keep the final value; the counting copy is decorative.
        const finalCopy = document.createElement('span');
        finalCopy.className = 'sr-only count-final';
        finalCopy.textContent = final;
        const shown = document.createElement('span');
        shown.className = 'count';
        shown.setAttribute('aria-hidden', 'true');
        const format = (/** @type {number} */ v) => `${v.toFixed(to.decimals)}${to.gap}${to.unit}`;
        shown.textContent = format(from);
        node.replaceWith(finalCopy, shown);

        counters.set(result, () => {
          const start = performance.now();
          const step = (/** @type {number} */ now) => {
            const t = Math.min(1, (now - start) / 1100);
            shown.textContent = t < 1 ? format(from + (to.n - from) * ease(t)) : final;
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        });
      } else {
        after.classList.add('is-waiting'); // Words ("Vue 3", "minutes") fade in after the strike instead.
      }
      io.observe(result);
    });
  }

  /* ——— Blocks below the fold rise in as they scroll into view ——— */

  if (moving() && 'IntersectionObserver' in window) {
    const blocks = [
      ...document.querySelectorAll('.section > h2, .now, .domains, .result, .jobs > li, .skills > .pair, .rows > .row'),
    ].filter((el) => el.getBoundingClientRect().top > innerHeight * 0.95);
    blocks.forEach((el) => el.classList.add('is-hidden'));

    const io = new IntersectionObserver(
      (entries) => {
        entries
          .filter((e) => e.isIntersecting)
          .forEach((e, i) => {
            const el = /** @type {HTMLElement} */ (e.target);
            el.style.transitionDelay = `${i * 60}ms`;
            el.classList.add('is-shown');
            io.unobserve(el);
          });
      },
      // No negative bottom margin: blocks at the very end of the page must reveal even when it can't scroll further.
      { threshold: 0.08 },
    );
    blocks.forEach((el) => io.observe(el));
  }
</script>

