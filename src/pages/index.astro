---
// The CV page: a sticky profile column on the left, the sections on the right (one column below 1024px).
// Content is edited in src/data/, each part of the page is a component, the page grid is in styles/layout.css.
import BaseLayout from '@layouts/BaseLayout.astro';
import ProfileHeader from '@components/profile/ProfileHeader.astro';
import ProfileLinks from '@components/profile/ProfileLinks.astro';
import SectionNav from '@components/profile/SectionNav.astro';
import Background from '@components/sections/Background.astro';
import Contact from '@components/sections/Contact.astro';
import Experience from '@components/sections/Experience.astro';
import Overview from '@components/sections/Overview.astro';
import Results from '@components/sections/Results.astro';
import Skills from '@components/sections/Skills.astro';
import SiteFooter from '@components/SiteFooter.astro';
import { experience } from '@data/experience.js';
import { profile } from '@data/profile.js';
import { results } from '@data/results.js';
import { skills } from '@data/skills.js';
import { fieldValue, listOf } from '@lib/content.js';
import { titleFromLabels } from '@lib/text.js';

// Section anchors and headings.
const sections = {
  overview: { id: 'overview', title: 'Overview' },
  results: { id: 'results', title: 'Results' },
  experience: { id: 'experience', title: 'Experience' },
  skills: { id: 'skills', title: 'Skills' },
  // "Education and languages", from the row labels, so a new row renames the section too.
  background: { id: 'background', title: titleFromLabels(profile.background.map((row) => row.label)) },
  contact: { id: 'contact', title: 'Contact' },
};

// The section list in the profile column. Education and languages is read under Skills, so it isn't listed.
const nav = [
  sections.overview,
  ...(results.length > 0 ? [sections.results] : []),
  sections.experience,
  sections.skills,
  sections.contact,
];
---

<BaseLayout title={profile.meta.title} description={profile.meta.description}>
  <div class="page">
    <div class="page-side">
      <ProfileHeader profile={profile} />
      <SectionNav sections={nav} />
      <ProfileLinks links={profile.links} />
    </div>

    <div class="page-main">
      <main class="content">
        <Overview {...sections.overview} job={experience[0]} domains={listOf(fieldValue(profile, 'Domains'))} />
        {results.length > 0 && <Results {...sections.results} items={results} />}
        <Experience {...sections.experience} jobs={experience} />
        <Skills {...sections.skills} groups={skills} />
        {profile.background.length > 0 && <Background {...sections.background} rows={profile.background} />}
        <Contact {...sections.contact} links={profile.links} cv={profile.cv} />
      </main>

      <SiteFooter name={profile.name} />
    </div>
  </div>

  <script>
    import { initReveal } from '@scripts/reveal.js';

    initReveal(document.querySelectorAll('[data-reveal]'));
  </script>
</BaseLayout>
