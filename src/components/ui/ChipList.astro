---
// A wrapping list of small tags: domains, skills, a job's stack.

/** @type {{ items: string[], label?: string }} */
const { items, label } = Astro.props;
---

<ul class="chips" aria-label={label}>
  {items.map((item) => (
    <li class="chip">{item}</li>
  ))}
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .chip {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--panel);
    font-size: 0.8125rem;
    line-height: 1.5;
    white-space: nowrap;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .chip {
      transition:
        background-color 0.15s,
        border-color 0.15s,
        color 0.15s;
    }

    .chip:hover {
      border-color: transparent;
      background: var(--accent-soft);
      color: var(--accent);
    }
  }
</style>
