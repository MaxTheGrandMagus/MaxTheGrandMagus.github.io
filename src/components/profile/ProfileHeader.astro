---
// The top of the profile column: avatar and theme switch, name, role, intro, key facts and the main actions.
import KeepHyphens from '@components/ui/KeepHyphens.astro';
import { emailLink, fieldValue } from '@lib/content.js';
import { yearsSince } from '@lib/dates.js';
import { initialsOf } from '@lib/text.js';
import LocalTime from './LocalTime.astro';
import ThemeToggle from './ThemeToggle.astro';

/** @type {{ profile: import('@lib/content.js').Profile }} */
const { profile } = Astro.props;

const email = emailLink(profile.links);

// Short facts under the intro; "Based in" also shows the live local time.
const facts = [
  { label: 'Based in', value: fieldValue(profile, 'Based in'), clock: true },
  { label: 'Works', value: fieldValue(profile, 'Works'), clock: false },
  { label: 'Experience', value: `${yearsSince(profile.careerStart)}+ years`, clock: false },
].filter((fact) => fact.value);
---

<header class="profile">
  <div class="profile-top">
    <div class="avatar" aria-hidden="true">
      {initialsOf(profile.name)}
    </div>
    <ThemeToggle />
  </div>
  <h1>{profile.name}</h1>
  <p class="role">{profile.role}</p>
  {profile.intro && (
    <p class="intro">
      <KeepHyphens text={profile.intro} />
    </p>
  )}
  <dl class="facts">
    {facts.map((fact) => (
      <div>
        <dt>{fact.label}</dt>
        <dd>
          {fact.value}
          {fact.clock && <LocalTime timeZone={profile.timezone} />}
        </dd>
      </div>
    ))}
  </dl>
  <div class="actions">
    {profile.cv && (
      <a class="button" href={profile.cv} download>
        Download CV (PDF)
      </a>
    )}
    {email && (
      <a class="text-link" href={email.href}>
        Email me
      </a>
    )}
  </div>
</header>

<style>
  .profile-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    /* 24px makes the initials large text, so the light pair (4:1) clears the 3:1 bar. */
    font-size: 1.5rem;
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.01em;
    user-select: none;
  }

  h1 {
    margin-top: 1.25rem;
    font-size: 2.125rem;
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .role {
    margin-top: 0.375rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .intro {
    max-width: 40ch;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .facts {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .facts > div {
    display: grid;
    grid-template-columns: 5.75rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
  }

  .facts > div:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    border-radius: 8px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .button:hover {
    background: color-mix(in srgb, var(--ink) 84%, var(--bg));
    color: var(--bg);
  }

  .text-link {
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Laptop heights: a tighter column keeps the section list above the fold. */
  @media (width >= 64rem) and (height < 55rem) {
    h1 {
      margin-top: 1rem;
    }

    .intro {
      margin-top: 0.875rem;
    }

    .facts {
      margin-top: 1.125rem;
    }

    .facts > div {
      padding-block: 0.375rem;
    }

    .actions {
      margin-top: 1.125rem;
    }
  }

  @media (width < 64rem) {
    .button {
      min-height: 44px;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .button {
      transition:
        background-color 0.15s,
        scale 0.12s var(--ease);
    }

    .button:active {
      scale: 0.96;
    }
  }

  @media print {
    .actions {
      display: none !important;
    }
  }
</style>
